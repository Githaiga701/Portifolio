# Daraja credentials are server-only. Never prefix these with NEXT_PUBLIC_.
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# Must be a publicly reachable HTTPS URL in deployed environments.
MPESA_CALLBACK_URL=https://your-domain.example/api/mpesa/callback
# Use CustomerBuyGoodsOnline for a Till Number; otherwise CustomerPayBillOnline.
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
